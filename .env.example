# ==============================================================================
# AFES 2.0 - Environment Variable Template
# ==============================================================================
# WARNING: DO NOT STORE REAL SECRETS OR SENSITIVE CREDENTIALS IN THIS FILE.
# Copy this file to `.env` for local development and fill in local values.
# NEVER commit the `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
LOG_LEVEL=info
DEBUG=afes:*

# ------------------------------------------------------------------------------
# Simulation & Hardware Validation Mode
# Set HARDWARE_SIMULATION_MODE=true for local mock data without physical nodes.
# Set HARDWARE_SIMULATION_MODE=false when running against physical hardware/sensors.
# ------------------------------------------------------------------------------
HARDWARE_SIMULATION_MODE=true
SIMULATION_NODE_COUNT=3
SIMULATION_INTERVAL_MS=2000

# ------------------------------------------------------------------------------
# MQTT Broker / Local Gateway Configuration
# ------------------------------------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=afes-backend-dev
MQTT_USERNAME=afes_dev_user
MQTT_PASSWORD=placeholder_local_mqtt_password
MQTT_TOPIC_PREFIX=afes/v1/telemetry
MQTT_KEEP_ALIVE=60

# ------------------------------------------------------------------------------
# CoreIOT Platform Integration
# ------------------------------------------------------------------------------
COREIOT_API_BASE_URL=https://api.coreiot.example.local/v1
COREIOT_DEVICE_PROVISIONING_TOKEN=placeholder_coreiot_provisioning_token
COREIOT_TELEMETRY_ENDPOINT=/api/v1/telemetry
COREIOT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Database Storage (Telemetry & Event History)
# ------------------------------------------------------------------------------
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afes_dev_db
DB_USER=afes_dev_user
DB_PASSWORD=placeholder_local_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# Emergency Alert & Notification Channels (Mock / Testing)
# ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=http://localhost:8080/mock/alert-webhook
ALERT_SMS_API_KEY=placeholder_alert_sms_key
ALERT_EMAIL_RECIPIENTS=developer-sandbox@example.local
