# AFES 2.0 local simulator/gateway environment template.
# Never commit a real .env file or platform credentials.

# Evidence mode: true is SIMULATION; false requires actual physical evidence.
HARDWARE_SIMULATION_MODE=true
SIMULATION_NODE_COUNT=3
SIMULATION_INTERVAL_MS=2000

# Local Gateway operations surface.
GATEWAY_HEALTH_HOST=127.0.0.1
GATEWAY_HEALTH_PORT=8080
LOG_LEVEL=info

# MQTT contract: afes/v2/{tenant_id}/devices/{device_id}/{channel}
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=afes-local-gateway-dev
MQTT_USERNAME=placeholder_mqtt_user
MQTT_PASSWORD=placeholder_local_mqtt_password
MQTT_TOPIC_PREFIX=afes/v2/default/
MQTT_TOPIC_TELEMETRY=afes/v2/{tenant_id}/devices/{device_id}/telemetry
MQTT_TOPIC_STATUS=afes/v2/{tenant_id}/devices/{device_id}/status
MQTT_TOPIC_EVENTS=afes/v2/{tenant_id}/devices/{device_id}/events
MQTT_KEEP_ALIVE=60

# CoreIOT values remain placeholders. Supply real values only through a secure,
# untracked local environment after Issue #3 onboarding is complete.
COREIOT_API_BASE_URL=https://coreiot.example.local
COREIOT_DEVICE_PROVISIONING_TOKEN=placeholder_coreiot_provisioning_token
COREIOT_TIMEOUT_MS=5000

# Local sink used only to test CoreIOT notification configuration.
COREIOT_TEST_WEBHOOK_URL=http://127.0.0.1:8081/coreiot-test-webhook
