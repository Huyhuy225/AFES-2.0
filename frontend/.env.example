# AFES 2.0 Frontend Environment Template
# Note: Do NOT commit secrets or actual credentials here.

# Backend Application API Base URL (Spring Boot Security Facade)
VITE_API_URL=http://localhost:8080/api/v2

# Backend WebSocket Stream Endpoint (STOMP over WS)
VITE_WS_STREAM_URL=ws://localhost:8080/ws/v2/stream

# Enable built-in mock telemetry and simulation mode (true/false)
VITE_USE_MOCK_DATA=true

# Polling interval in milliseconds when running in REST fallback mode
VITE_POLL_INTERVAL_MS=3000

# Application lifecycle environment tag (Stage A: SIMULATION vs Stage B: PHYSICAL)
VITE_SYSTEM_STAGE=STAGE_A_SIMULATION
