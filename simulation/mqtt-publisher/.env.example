# ==============================================================================
# AFES 2.0 Stage A Virtual Telemetry Simulator - Environment Template
# ==============================================================================
# [SIMULATED - STAGE A] Hardware-independent virtual ESP32-S3 configuration.
# WARNING: DO NOT COMMIT REAL SECRETS, TOKENS, OR PRODUCTION BROKER ENDPOINTS.
# Copy this file to a local, git-ignored `.env` if needed for local broker runs.
# Offline tests and stdout/memory runs require NO `.env` file and NO credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Identity & Spatial Coordinates (AFES v2 Contract: docs/TELEMETRY_SCHEMA.md)
# Topic pattern: afes/v2/{tenant_id}/devices/{device_id}/telemetry (QoS 1)
# ------------------------------------------------------------------------------
AFES_SIM_TENANT_ID=stage-a-sim
AFES_SIM_DEVICE_ID=SIM-ESP32-101
AFES_SIM_GATEWAY_ID=GW-LOCAL-PC01
AFES_SIM_ZONE_ID=ZONE-101
AFES_SIM_ROOM_CODE=ROOM-101
AFES_SIM_BUILDING_ID=BLDG-CSE
AFES_SIM_FLOOR_LEVEL=1

# ------------------------------------------------------------------------------
# Virtual Scenario & Deterministic Generation Controls
# Allowed scenarios: normal | warning-smoke | critical-fire
# ------------------------------------------------------------------------------
AFES_SIM_SCENARIO=normal
AFES_SIM_FIXTURE_MODE=true
AFES_SIM_SEED=6
AFES_SIM_START_EPOCH_MS=1794457200000
AFES_SIM_INTERVAL_MS=2000
AFES_SIM_COUNT=10
AFES_SIM_NOISE=true

# ------------------------------------------------------------------------------
# Optional Local MQTT Broker Transport (--transport mqtt only)
# Placeholders only; never commit real credentials or production endpoints.
# ------------------------------------------------------------------------------
AFES_SIM_MQTT_HOST=localhost
AFES_SIM_MQTT_PORT=1883
AFES_SIM_MQTT_CLIENT_ID=afes-stage-a-sim-SIM-ESP32-101
AFES_SIM_MQTT_USERNAME=placeholder_mqtt_user
AFES_SIM_MQTT_PASSWORD=placeholder_local_mqtt_password
AFES_SIM_MQTT_TLS=false
AFES_SIM_MQTT_TLS_CA_FILE=
AFES_SIM_MQTT_KEEPALIVE_S=60
AFES_SIM_MQTT_CONNECT_TIMEOUT_S=5.0
AFES_SIM_MQTT_CONNECT_ATTEMPTS=3
AFES_SIM_MQTT_RETRY_BACKOFF_S=1.0
AFES_SIM_ALLOW_INSECURE_REMOTE_AUTH=false
